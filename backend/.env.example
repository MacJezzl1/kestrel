# Kestrel Backend — Environment Configuration
# Copy this file to .env and configure for your environment.

DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./kestrel.db

# JWT & Authentication (15-min access token + 7-day refresh)
JWT_SECRET_KEY=your-jwt-secret-key-at-least-64-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# MT5 Bridge HMAC Signing (30s anti-replay window)
MT5_ADAPTER_SECRET=your-mt5-bridge-hmac-adapter-secret
HMAC_MAX_DRIFT_SECONDS=30

# CORS
CORS_ORIGINS=["http://localhost:3000","https://frontend-delta-pied-96.vercel.app"]

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

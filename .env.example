# Kestrel AI Trading Intelligence Platform — Environment Configuration
# Copy this file to .env and configure for your environment.

# App Settings
APP_NAME=Kestrel
APP_VERSION=0.2.0
DEBUG=false

# Database Configuration
# Local SQLite for dev, or PostgreSQL (Supabase connection pooler) for production
DATABASE_URL=sqlite+aiosqlite:///./kestrel.db
# DATABASE_URL=postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Auth0-Grade JWT / Auth
# Generate via: openssl rand -base64 48
JWT_SECRET_KEY=your-jwt-secret-key-at-least-64-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional: Asymmetric RS256 Keypair (PEM format)
# JWT_ALGORITHM=RS256
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# MetaTrader 5 Bridge & HMAC Request Signing
# Generate via: openssl rand -hex 32
MT5_ADAPTER_SECRET=your-mt5-bridge-hmac-adapter-secret
HMAC_MAX_DRIFT_SECONDS=30

# Supabase Cloud Database Integration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# AI Swarm
AI_SWARM_MODELS_COUNT=180
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=your-groq-api-key
TOGETHER_API_KEY=your-together-api-key
MISTRAL_API_KEY=your-mistral-api-key
